# .env.example — Landing Gob Perú
#
# Copia este archivo a `.env` y rellena los valores. El `.env` real esta
# gitignored y NUNCA se commitea.
#
# REGLA: cada variable lleva arriba un comentario con dos datos obligatorios:
#   ORIGEN:  de donde sale el valor real (que consola, que comando, quien lo da)
#   PROD:    donde se setea en produccion (que sistema de secretos, que panel)
# Sin esos dos datos la variable es inutil para quien llega nuevo: sabe que
# existe pero no como conseguirla.
#
# REGLA 2: aqui van NOMBRES, nunca valores reales. Ni siquiera "de ejemplo pero
# que funcionan". Un valor real en este archivo es un secreto filtrado.

# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------

# ORIGEN: lo eliges tu. Valores: local | staging | production
# PROD:   variable de entorno del runtime de despliegue
APP_ENV=local

# ORIGEN: lo eliges tu. Nivel de log: debug | info | warn | error
# PROD:   variable de entorno del runtime de despliegue
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Almacenamiento principal
# ---------------------------------------------------------------------------
# Borra este bloque entero si el proyecto no persiste estado (una libreria, un
# analisis reproducible o un CLI sin almacen no lo necesitan).

# ORIGEN: cadena de conexion del almacen local que levantas en tu maquina
#         (el procedimiento para levantarlo se documenta en el README
#         cuando F2 fije el contrato; en el bootstrap todavia no existe).
# PROD:   gestor de secretos del entorno de despliegue. Nunca en el repo,
#         nunca en un archivo de compose commiteado.
DATA_STORE_URL=

# ---------------------------------------------------------------------------
# Servicios externos
# ---------------------------------------------------------------------------
# Borra este bloque entero si ninguno es "ninguno" o si el proyecto no habla
# con ningun servicio de terceros.

# ORIGEN: consola del proveedor -> seccion de API keys -> crear key de desarrollo.
#         Usa una key PERSONAL de dev, no la key compartida del equipo.
# PROD:   gestor de secretos del entorno de despliegue, con una key distinta
#         y rotada de forma independiente a la de dev.
EXTERNAL_SERVICE_API_KEY=

# ORIGEN: misma consola del proveedor, identificador del workspace/proyecto.
#         No es secreto, pero cambia entre entornos, asi que va aqui.
# PROD:   variable de entorno del runtime de despliegue
EXTERNAL_SERVICE_WORKSPACE_ID=

# ---------------------------------------------------------------------------
# Tracker de trabajo (ninguno)
# ---------------------------------------------------------------------------
# Solo si el proyecto automatiza contra el tracker. Si ninguno es "ninguno",
# borra este bloque entero.

# ORIGEN: ajustes de cuenta de ninguno -> API / tokens personales.
# PROD:   solo se usa desde maquinas de desarrollo y CI; en CI va como secreto
#         del pipeline, nunca en el YAML del workflow.
TRACKER_API_TOKEN=

# ORIGEN: la URL o los ajustes del proyecto en ninguno.
# PROD:   variable de entorno del runtime de CI
TRACKER_PROJECT_KEY=

# ---------------------------------------------------------------------------
# Firma de sesion / criptografia
# ---------------------------------------------------------------------------
# Borra este bloque si el proyecto no maneja sesiones ni tokens firmados.

# ORIGEN: generala tu con un generador de aleatorios criptografico
#         (>= 32 bytes). En local puede ser cualquier cadena larga.
# PROD:   gestor de secretos. Valor DISTINTO al de dev. Rotarlo invalida
#         todas las sesiones vivas: planificar la rotacion.
SESSION_SIGNING_KEY=
